# Cache busting - força navegador a sempre buscar nova versão do HTML
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Assets com hash no nome podem ter cache longo (Vite já adiciona hash)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker e manifest
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate
