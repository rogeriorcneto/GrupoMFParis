# Supabase (mesmas credenciais do frontend/.env)
SUPABASE_URL=https://zeaeppmnetdhzwwdydmq.supabase.co
SUPABASE_ANON_KEY=sua_chave_aqui

# Servidor
BOT_PORT=3001

# Email SMTP (opcional - para envio de emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu@email.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=Grupo MF Paris <seu@email.com>

# Inbox IMAP (opcional - para ler emails recebidos dentro do CRM)
# Se não preencher, o backend tenta usar EMAIL_USER/EMAIL_PASS e host imap.* automático.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=seu@email.com
EMAIL_IMAP_PASS=xxxx xxxx xxxx xxxx
EMAIL_IMAP_SECURE=true

# Gemini AI (obrigatório para a IA funcionar)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Omie ERP (opcional - pode ser configurado pela interface do CRM)
# OMIE_APP_KEY=999999999
# OMIE_APP_SECRET=sua_chave_secreta_aqui

# CORS - URLs permitidas (separar com vírgula)
# Dev: http://localhost:5173,http://localhost:4173
# Produção: adicione o domínio real do Netlify, ex: https://mfparis-crm.netlify.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
